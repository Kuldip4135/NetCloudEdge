{
  "name": "yash-thakor-website",
  "version": "1.0.0",
  "private": true,
  "description": "Recruiting & staffing company website — 11ty + Tailwind CSS, static build.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/assets/css/input.css -o ./dist/assets/css/style.css",
    "watch:css": "tailwindcss -i ./src/assets/css/input.css -o ./dist/assets/css/style.css --watch",
    "build:eleventy": "eleventy",
    "watch:eleventy": "eleventy --serve",
    "build": "npm run build:css && npm run build:eleventy",
    "dev": "npm-run-all --parallel watch:css watch:eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.13"
  }
}
