  {% set candidateQuotes = [] %}
  {% for t in testimonials.list %}
    {% if not t.employer and t.slug != "sofia" %}{% set _ = candidateQuotes.push(t) %}{% endif %}
  {% endfor %}
  <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
    {% for testimonial in candidateQuotes.slice(0, 4) %}
      {% include "partials/testimonial-card.njk" %}
    {% endfor %}
  </div>
</section>
#}

