---
layout: layouts/page.njk
title: Background Verification
description: Employment history, education, and reference verification handled quickly and correctly, so an offer becomes a hire with confidence.
extraScripts:
  - /assets/js/faq-accordion.js
---
{% from "partials/icons.njk" import icon %}

<section class="py-14 sm:py-20">
  <div class="section-container flex flex-col lg:flex-row lg:items-center gap-10 lg:gap-16">
    <div class="lg:w-1/2">
      {% set crumbs = [{ label: "Home", url: "/" }, { label: "Services", url: "/services/" }, { label: "Background Verification" }] %}
      {% include "partials/breadcrumb.njk" %}
      <h1 class="font-display text-4xl sm:text-5xl font-semibold text-ink mt-4 leading-tight">Confidence Before the Hire</h1>
      <p class="mt-5 text-lg text-ink/65 leading-relaxed">Thorough, compliant verification so an offer becomes a hire without second-guessing.</p>
      <a href="{{ '/contact/' | url }}" class="btn-primary inline-block mt-7">Request a Verification</a>
    </div>
    <div class="lg:w-1/2">
      <div class="aspect-[4/3] rounded-3xl bg-surface flex items-center justify-center">
        <span class="flex items-center justify-center w-20 h-20 rounded-2xl bg-paper text-brand">{{ icon("shield", "w-9 h-9") }}</span>
      </div>
    </div>
  </div>
</section>

<section class="py-16 sm:py-24 bg-surface">
  <div class="section-container">
    <div class="max-w-2xl mb-12">
      <p class="eyebrow">What we verify</p>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold text-ink mt-2">A complete picture, checked</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {% set included = [
        { icon: "briefcase", title: "Employment History", text: "Confirmed dates, titles, and roles directly with past employers." },
        { icon: "code", title: "Education Verification", text: "Degrees and certifications confirmed at the source." },
        { icon: "shield", title: "Criminal Record Check", text: "Conducted where legally permitted, scoped to the role." },
        { icon: "users", title: "Reference Checks", text: "Structured conversations with the people who worked with the candidate directly." },
        { icon: "check", title: "Identity Verification", text: "Confirms the candidate is who their application says they are." }
      ] %}
      {% for item in included %}
      <div class="bg-paper rounded-2xl p-6">
        <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-surface text-brand">{{ icon(item.icon, "w-5 h-5") }}</span>
        <h3 class="font-display text-lg font-semibold text-ink mt-4">{{ item.title }}</h3>
        <p class="mt-2 text-sm text-ink/65 leading-relaxed">{{ item.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="py-16 sm:py-24">
  <div class="section-container max-w-3xl">
    <p class="eyebrow">Compliance</p>
    <h2 class="font-display text-3xl sm:text-4xl font-semibold text-ink mt-2 mb-5">Handled correctly, every time</h2>
    <p class="text-ink/70 leading-relaxed">
      Every check begins with documented candidate consent, and every report is scoped to what's legally permitted for the role and jurisdiction. Data is encrypted in transit and at rest, accessible only to the parties directly involved in the hiring decision, and retained only as long as required by applicable law. We don't display third-party compliance badges we haven't earned — if you have specific regulatory requirements for a role, tell us and we'll confirm in writing what our process covers.
    </p>
  </div>
</section>

{% set steps = [
  { label: "Request", description: "Tell us which candidate and which checks the role requires." },
  { label: "Consent Collection", description: "We collect documented consent directly from the candidate." },
  { label: "Verification", description: "Employment, education, and reference checks run in parallel." },
  { label: "Report Delivery", description: "A clear, scoped report delivered within days, not weeks." }
] %}
{% set sectionEyebrow = "The process" %}
{% set sectionTitle = "From request to report" %}
{% include "partials/process-timeline.njk" %}

{% set faqKey = "background-verification" %}
{% include "partials/faq-accordion.njk" %}

{% set ctaHeadline = "Ready to verify a candidate?" %}
{% set ctaLabel = "Request a Check" %}
{% set ctaHref = "/contact/" %}
{% set ctaVariant = "brand" %}
{% include "partials/cta-section.njk" %}
