---
layout: layouts/page.njk
title: Recruitment & Staffing
description: Full-cycle staffing for employers — sourcing, screening, and delivering vetted candidates across contract, temp, and permanent roles.
glass: true
extraScripts:
  - /assets/js/count-up.js
  - /assets/js/faq-accordion.js
---
{% from "partials/icons.njk" import icon %}

{# ================================================================
   RECRUITMENT & STAFFING — Hallmark audit pass, matching job-placement.njk.

   Hero drops the aurora/dot background; section heads are single-column with the
   label directly above the heading (no chapter-marker ghost index, no eyebrow on
   non-ordinal sections); the "what's included" grid is a definition list with
   inline icons on hairline rules, not glass cards with stacked icon chips.
   Fabricated proof (employer quote wall, logo marquee) is gated — see TODOs.
   ================================================================ #}

{% set crumbs = [{ label: "Home", url: "/" }, { label: "Services", url: "/services/" }, { label: "Recruitment & Staffing" }] %}

{# ---------- Hero ---------- #}
<section class="relative overflow-hidden">
  <div class="section-container pb-14 pt-8 sm:pb-20 sm:pt-12">
    {% include "partials/breadcrumb.njk" %}

    <div class="mt-8 grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <p class="eyebrow">Contingency — you pay on placement</p>

        <h1 class="mt-4 font-grotesk text-4xl font-bold leading-[1.05] tracking-tight text-ink sm:text-6xl">
          Hire faster, hire right.
        </h1>
        <p class="lead-copy mt-5 max-w-xl">
          Vetted candidates for contract, temp, or full-time roles — delivered
          faster than sifting through a job board yourself.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="{{ '/contact/' | url }}" class="btn-primary">
            {{ icon("arrow-right", "w-4 h-4") }} Tell us your hiring need
          </a>
          <a href="{{ '/services/talent-acquisition/' | url }}" class="btn-outline">
            Compare with search
          </a>
        </div>

        {# TODO: confirm these figures with the client before launch — see stats.json. #}
        <dl class="mt-10 grid max-w-lg grid-cols-3 gap-4 border-t border-ink/10 pt-6">
          {% for stat in stats.list.slice(0, 3) %}
          <div>
            <dd class="stat-figure text-xl sm:text-2xl"
                data-count-up data-target="{{ stat.value }}" data-suffix="{{ stat.suffix }}">0{{ stat.suffix }}</dd>
            <dt class="stat-label">{{ stat.label }}</dt>
          </div>
          {% endfor %}
        </dl>
      </div>

      <div class="relative lg:col-span-5">
        {% set coverImage = images.services["recruitment-staffing"].cover %}
        <div class="glass-panel p-3">
          <img src="{{ coverImage.url }}"
               alt="{{ coverImage.alt }}"
               width="1400" height="933" loading="eager" fetchpriority="high"
               class="aspect-[4/5] w-full rounded-[1.1rem] object-cover">
        </div>

        {# Frost, not pane — it floats over the photograph. See THEME.md §3. #}
        <div class="glass-frost absolute -bottom-4 left-6 rounded-2xl px-5 py-3.5 sm:-left-6">
          <p class="meta">To start</p>
          <p class="font-grotesk text-2xl font-bold tracking-tight text-ink">15 min</p>
        </div>
      </div>
    </div>
  </div>
</section>

{# TODO — Employer wall gated. `placed-at.njk` hotlinks logo.clearbit.com for named
   companies, which reads as a verified client list. Re-enable only with a real,
   permitted set of employer names.
{% set placedAtTitle = "Hired through us" %}
{% set placedAtLead = "Teams that filled a role this way." %}
{% include "partials/placed-at.njk" %}
#}

{# ---------- What's included ---------- #}
<section id="included" class="section-container scroll-mt-28 py-16 sm:py-24">
  <div class="max-w-2xl">
    <h2 class="section-title">Four things every engagement gets.</h2>
    <p class="lead-copy mt-4">Built for how you actually hire, whatever the role structure.</p>
  </div>

  {% set included = [
    { icon: "target", t: "Candidate sourcing", d: "Active and passive candidate networks built specifically for your role, not a job-board repost." },
    { icon: "shield", t: "Screening & vetting", d: "Skills, references, and fit assessed before a candidate ever reaches your inbox." },
    { icon: "briefcase", t: "Staffing models", d: "Contract, temp-to-hire, or permanent — whichever structure fits the role." },
    { icon: "users", t: "Industry specializations", d: "Dedicated sourcing pipelines in technology, finance, healthcare, and more." }
  ] %}
  <dl class="mt-10 grid gap-x-12 gap-y-7 sm:grid-cols-2">
    {% for item in included %}
    <div class="flex gap-4 border-t border-ink/15 pt-5">
      <span class="mt-0.5 shrink-0 text-brand">{{ icon(item.icon, "w-5 h-5") }}</span>
      <div>
        <dt class="card-title">{{ item.t }}</dt>
        <dd class="mt-1.5 body-copy">{{ item.d }}</dd>
      </div>
    </div>
    {% endfor %}
  </dl>
</section>

{# ---------- Where we place ----------
   Employers scan for their own sector before reading anything else, so this sits
   high. Shares come from _data/industries.json. ---------- #}
<section id="sectors" class="scroll-mt-28 border-y border-white/60 bg-paper/50 py-16 sm:py-24">
  <div class="section-container">
    <div class="max-w-2xl">
      <h2 class="section-title">Where we place.</h2>
      <p class="lead-copy mt-4">Employers scan for their own sector first. Here's ours.</p>
    </div>
    <ul class="mt-10 grid gap-x-12 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
      {% for industry in industries.list %}
      <li class="flex gap-4 border-t border-ink/15 pt-5">
        <span class="mt-0.5 shrink-0 text-brand">{{ icon(industry.icon, "w-5 h-5") }}</span>
        <div>
          <p class="card-title">{{ industry.name }}</p>
          <p class="mt-1.5 body-copy">{{ industry.roles }}</p>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{# ---------- How engagements work ----------
   Structure, not rates — an employer who can't find terms assumes they're bad.
   The terms live in their own accent panel beside the prose. ---------- #}
<section id="terms" class="section-container scroll-mt-28 py-16 sm:py-24">
  <div class="max-w-2xl">
    <h2 class="section-title">How engagements work.</h2>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-5 lg:items-start">
    <ul class="space-y-5 lg:col-span-3">
      {% set terms = [
        { t: "Permanent placements", d: "Contingency-based. You pay when someone starts, not before." },
        { t: "Contract & temp", d: "A flat markup on hourly billing, quoted upfront." },
        { t: "No retainer", d: "Nothing to begin, and no minimum for a one-off role." },
        { t: "Ongoing partnerships", d: "Move to a dedicated account structure once volume picks up." }
      ] %}
      {% for term in terms %}
      <li class="grid grid-cols-1 gap-1 sm:grid-cols-12 sm:gap-4">
        <p class="font-display font-semibold tracking-tight text-ink sm:col-span-4">{{ term.t }}</p>
        <p class="body-copy sm:col-span-8">{{ term.d }}</p>
      </li>
      {% endfor %}
    </ul>

    <div class="rounded-2xl border border-brand/25 bg-brand/10 p-6 sm:p-7 lg:col-span-2">
      <p class="meta">Terms at a glance</p>
      <dl class="mt-4 space-y-4">
        <div class="flex flex-col-reverse">
          <dt class="mt-0.5 meta">Permanent</dt>
          <dd class="text-sm font-medium leading-snug text-ink">Contingency — you pay on placement</dd>
        </div>
        <div class="flex flex-col-reverse">
          <dt class="mt-0.5 meta">Contract</dt>
          <dd class="text-sm font-medium leading-snug text-ink">Flat hourly markup, no retainer</dd>
        </div>
        <div class="flex flex-col-reverse">
          <dt class="mt-0.5 meta">To start</dt>
          <dd class="text-sm font-medium leading-snug text-ink">A role brief and 15 minutes</dd>
        </div>
      </dl>
      <a href="{{ '/contact/' | url }}" class="mt-5 link-arrow">
        Tell us your hiring need {{ icon("arrow-right", "w-4 h-4") }}
      </a>
    </div>
  </div>

  <p class="mt-8 file-inset meta max-w-2xl leading-relaxed">
    Rates depend on role and seniority — we'll quote before any work begins.
  </p>
</section>

{# ---------- The process ---------- #}
<section id="procedure" class="scroll-mt-28 border-y border-white/60 bg-paper/50 py-16 sm:py-24">
  <div class="section-container">
    <div class="max-w-2xl">
      <p class="eyebrow">Step by step</p>
      <h2 class="section-title mt-2">From requirement to onboarding.</h2>
    </div>
    <div class="mt-10">
      {% set steps = [
        { label: "Requirement analysis", description: "We start with the role, the team, and what \"right\" actually looks like." },
        { label: "Sourcing", description: "Active outreach across our network, not a passive posting." },
        { label: "Screening", description: "Skills and reference checks before you see a single resume." },
        { label: "Client interviews", description: "A shortlist you can actually choose from." },
        { label: "Onboarding", description: "Support through the offer and the first day." }
      ] %}
      {% include "partials/process-timeline.njk" %}
    </div>
  </div>
</section>

{# TODO — Employer quotes gated. testimonials.json ships stock-photo placeholders
   with company names attached to the quotes. Re-enable once the quotes are real
   and attribution is permitted.

<section id="statements" class="section-container scroll-mt-28 py-16 sm:py-24">
  <h2 class="section-title">On record, from the hiring side.</h2>
  {% set employerQuotes = [] %}
  {% for t in testimonials.list %}
    {% if t.employer %}{% set _ = employerQuotes.push(t) %}{% endif %}
  {% endfor %}
  <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
    {% for testimonial in employerQuotes %}
      {% include "partials/testimonial-card.njk" %}
    {% endfor %}
  </div>
</section>
#}

{% set faqKey = "recruitment-staffing" %}
{% set faqTitle = "Before you brief us." %}
{% include "partials/faq-accordion.njk" %}

{% set ctaStamp = "Ready when you are" %}
{% set ctaHeadline = "Tell us your hiring need." %}
{% set ctaSubtext = "Describe the role and we'll come back with how we'd fill it, and what it would cost." %}
{% set ctaLabel = "Talk to Our Team" %}
{% set ctaHref = "/contact/?role=employer" %}
{% include "partials/cta-section.njk" %}
