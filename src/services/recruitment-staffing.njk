---
layout: layouts/page.njk
title: Recruitment & Staffing
description: Full-cycle staffing for employers — sourcing, screening, and delivering vetted candidates across contract, temp, and permanent roles.
extraScripts:
  - /assets/js/faq-accordion.js
  - /assets/js/rail-active.js
---
{% from "partials/icons.njk" import icon %}

{% set rail = [
  { id: "included",   label: "What's included", n: "00" },
  { id: "sectors",    label: "Where we place",  n: "A"  },
  { id: "terms",      label: "How engagements work", n: "B" },
  { id: "procedure",  label: "The process",     n: "C"  },
  { id: "statements", label: "From employers",  n: "D"  },
  { id: "faq",        label: "Questions",       n: "E"  }
] %}

{% set crumbs = [{ label: "Home", url: "/" }, { label: "Services", url: "/services/" }, { label: "Recruitment & Staffing" }] %}
{% set coverStamp = "File · 02" %}
{% set coverTitle = "Hire faster, hire right." %}
{% set coverLead = "Vetted candidates for contract, temp, or full-time roles — delivered faster than sifting through a job board yourself." %}
{% set coverPrimary = { label: "Tell Us Your Hiring Need", href: "/contact/" } %}
{% set coverSecondary = { label: "Compare with search", href: "/services/talent-acquisition/" } %}
{% set coverImage = images.services["recruitment-staffing"].cover %}
{% include "partials/cover-sheet.njk" %}

{# Terms pinned under the rail for the whole scroll. An employer with a role open now
   skims for commercial structure before reading a word of prose, and an employer who
   can't find terms assumes they're bad. Structure only — the actual rate is a
   conversation, and no percentage belongs on this page. #}
{% set railCard = {
  title: "Terms at a glance",
  rows: [
    { k: "Permanent", v: "Contingency — you pay on placement" },
    { k: "Contract", v: "Flat hourly markup, no retainer" },
    { k: "To start", v: "A role brief and 15 minutes" }
  ],
  cta: { label: "Tell us your hiring need", href: "/contact/" }
} %}

<section class="section-container py-14 sm:py-20">
  <div class="lg:grid lg:grid-cols-12 lg:gap-12">

    {% include "partials/section-rail.njk" %}

    <div class="lg:col-span-9">

      {# ---- 00 What's included ---- #}
      <div id="included" class="scroll-mt-28">
        <p class="eyebrow">00 — What's included</p>
        <h2 class="mt-2 max-w-xl font-display text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">
          Built for how you hire.
        </h2>
        <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
          {% set included = [
            { icon: "target", t: "Candidate sourcing", d: "Active and passive candidate networks built specifically for your role, not a job-board repost." },
            { icon: "shield", t: "Screening & vetting", d: "Skills, references, and fit assessed before a candidate ever reaches your inbox." },
            { icon: "briefcase", t: "Staffing models", d: "Contract, temp-to-hire, or permanent — whichever structure fits the role." },
            { icon: "users", t: "Industry specializations", d: "Dedicated sourcing pipelines in technology, finance, healthcare, and more." }
          ] %}
          {% for item in included %}
          <div class="folder-card p-5">
            <span class="flex h-9 w-9 items-center justify-center rounded-sm bg-brand/10 text-brand">{{ icon(item.icon, "w-4 h-4") }}</span>
            <h3 class="mt-3 font-display font-semibold tracking-tight text-ink">{{ item.t }}</h3>
            <p class="mt-2 body-copy">{{ item.d }}</p>
          </div>
          {% endfor %}
        </div>
      </div>

      {# ---- A Sectors. Employers scan for their own sector before reading anything
             else, so this sits high. Shares come from _data/industries.json. ---- #}
      <div id="sectors" class="mt-14 scroll-mt-28">
        <p class="eyebrow">A — Coverage</p>
        <h2 class="mt-2 max-w-xl font-display text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">
          Where we place.
        </h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink/75">
          Employers scan for their own sector first. Here's ours.
        </p>
        <div class="mt-6">
          <div class="docket-head">
            <span class="col-span-1"></span>
            <span class="col-span-5">Sector</span>
            <span class="col-span-4">Typical roles</span>
            <span class="col-span-2 text-right">Share</span>
          </div>
          {% for industry in industries.list %}
          <div class="docket-row group">
            <span class="col-span-2 flex h-9 w-9 items-center justify-center rounded-sm bg-surface text-ink/65 transition-colors group-hover:bg-brand group-hover:text-paper sm:col-span-1">
              {{ icon(industry.icon, "w-4 h-4") }}
            </span>
            <p class="col-span-10 font-display font-semibold tracking-tight text-ink sm:col-span-5">{{ industry.name }}</p>
            <p class="col-span-8 text-sm text-ink/65 sm:col-span-4">{{ industry.roles }}</p>
            <p class="col-span-4 text-right font-mono text-sm text-ink/70 sm:col-span-2">{{ industry.share }}</p>
          </div>
          {% endfor %}
        </div>
      </div>

      {# ---- B Commercial terms. Structure, not rates — employers who can't find terms
             assume they're bad. ---- #}
      <div id="terms" class="mt-14 scroll-mt-28">
        <p class="eyebrow">B — Terms</p>
        <h2 class="mt-2 max-w-xl font-display text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">
          How engagements work.
        </h2>
        <div class="mt-6 file-inset">
          <ul class="space-y-4">
            {% set terms = [
              { t: "Permanent placements", d: "Contingency-based. You pay when someone starts, not before." },
              { t: "Contract & temp", d: "A flat markup on hourly billing, quoted upfront." },
              { t: "No retainer", d: "Nothing to begin, and no minimum for a one-off role." },
              { t: "Ongoing partnerships", d: "Move to a dedicated account structure once volume picks up." }
            ] %}
            {% for term in terms %}
            <li class="grid grid-cols-1 gap-1 sm:grid-cols-12 sm:gap-4">
              <p class="font-display font-semibold tracking-tight text-ink sm:col-span-4">{{ term.t }}</p>
              <p class="body-copy sm:col-span-8">{{ term.d }}</p>
            </li>
            {% endfor %}
          </ul>
          <p class="mt-5 border-t border-dashed border-border pt-4 meta leading-relaxed">
            Rates depend on role and seniority — we'll quote before any work begins.
          </p>
        </div>
      </div>

      {# ---- C The process ---- #}
      <div class="mt-14">
        {% set steps = [
          { label: "Requirement analysis", description: "We start with the role, the team, and what \"right\" actually looks like." },
          { label: "Sourcing", description: "Active outreach across our network, not a passive posting." },
          { label: "Screening", description: "Skills and reference checks before you see a single resume." },
          { label: "Client interviews", description: "A shortlist you can actually choose from." },
          { label: "Onboarding", description: "Support through the offer and the first day." }
        ] %}
        {% set sectionId = "procedure" %}
        {% set sectionEyebrow = "C — The process" %}
        {% set sectionTitle = "From requirement to onboarding." %}
        {% include "partials/process-timeline.njk" %}
      </div>

      {# ---- D Employer statements. This stands in for the "94% / 18 days / 20+
             industries" proof band, which claims figures we don't track and which
             contradicted the six sectors listed above. ---- #}
      <div id="statements" class="mt-14 scroll-mt-28">
        <p class="eyebrow">D — Why employers choose us</p>
        <h2 class="mt-2 max-w-xl font-display text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">
          On record, from the hiring side.
        </h2>
        {% set employerQuotes = [] %}
        {% for t in testimonials.list %}
          {% if t.employer %}{% set _ = employerQuotes.push(t) %}{% endif %}
        {% endfor %}
        <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
          {% for testimonial in employerQuotes %}
            {% include "partials/testimonial-card.njk" %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% set faqKey = "recruitment-staffing" %}
{% set faqEyebrow = "E — Standing questions" %}
{% set faqTitle = "Before you brief us." %}
{% include "partials/faq-accordion.njk" %}

{% set ctaStamp = "Ready to open" %}
{% set ctaHeadline = "Tell us your hiring need." %}
{% set ctaSubtext = "Describe the role and we'll come back with how we'd fill it, and what it would cost." %}
{% set ctaLabel = "Talk to Our Team" %}
{% set ctaHref = "/contact/?role=employer" %}
{% include "partials/cta-section.njk" %}
