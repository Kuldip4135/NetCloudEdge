---
layout: layouts/page.njk
title: Home — Human
theme: human
permalink: /explore/human/
description: Recruiting and staffing for students starting out and professionals moving on — plus the employers who hire both.
---
{% from "partials/icons.njk" import icon %}

{# ================================================================
   THE CALLBACK — the whole homepage staged as one phone call: it
   opens on the incoming ring, spends its middle as a sticky call
   card next to a scrolling transcript of what actually gets said,
   and closes by handing the phone to the visitor. Replaces the
   stacked hero → grid → grid → stats → grid template entirely.
   ================================================================ #}

{# ---------- 1. Opener: the ring, not a hero banner ---------- #}
<section class="relative flex min-h-[88vh] flex-col items-center justify-center overflow-hidden px-4 py-20 text-center">
  <span class="orb -left-32 -top-32 h-[30rem] w-[30rem] bg-accent/15" aria-hidden="true"></span>
  <span class="orb -right-24 top-1/3 h-96 w-96 bg-brand/12" aria-hidden="true"></span>

  <p class="call-chip">
    <span class="relative flex h-2 w-2">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70 motion-reduce:animate-none"></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
    </span>
    Incoming call
  </p>

  <div class="relative mt-8 h-32 w-32 sm:h-40 sm:w-40">
    <span class="absolute inset-0 rounded-full bg-brand/20 motion-reduce:hidden" style="animation: ping 2.2s cubic-bezier(0,0,0.2,1) infinite;" aria-hidden="true"></span>
    <span class="relative flex h-full w-full items-center justify-center rounded-full bg-brand text-paper shadow-glass">
      {{ icon("phone", "w-12 h-12 sm:w-14 sm:h-14") }}
    </span>
  </div>

  <p class="mt-7 font-mono text-xs uppercase tracking-widest text-ink/45">{{ site.shortName }} Recruiting</p>
  <h1 class="mt-2 max-w-2xl font-display text-4xl font-semibold leading-tight tracking-tight text-ink sm:text-6xl">
    Somebody's calling about <span class="text-brand">your next role</span>.
  </h1>
  <p class="mt-5 max-w-md text-lg leading-relaxed text-ink/65">
    Or your next hire. Either way, a person picks up — not a portal, not an autoresponder.
  </p>

  <p class="mt-8 font-mono text-3xl font-semibold tracking-tight text-ink" data-call-timer>00:00</p>

  <div class="mt-8 flex flex-col gap-3 sm:flex-row">
    <a href="{{ '/services/job-placement/' | url }}" class="btn-primary">{{ icon("arrow-right", "w-4 h-4") }} Answer as a job seeker</a>
    <a href="{{ '/services/recruitment-staffing/' | url }}" class="btn-outline">{{ icon("arrow-right", "w-4 h-4") }} Answer as an employer</a>
  </div>

  <p class="mt-12 font-mono text-xs uppercase tracking-widest text-ink/35">Stay on the line ↓</p>
</section>

{# ---------- 2. The call: a sticky call card beside a scrolling transcript ---------- #}
<section class="py-16 sm:py-24">
  <div class="section-container lg:grid lg:grid-cols-12 lg:items-start lg:gap-12">

    {# Sticky call card — proof, live, always in frame while the transcript scrolls. #}
    <div class="lg:sticky lg:top-24 lg:col-span-4">
      <div class="soft-card p-6">
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand text-paper">
            {{ icon("phone", "w-5 h-5") }}
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate font-display font-semibold text-ink">On the line</p>
            <p class="truncate text-xs text-ink/55">Your recruiter, live</p>
          </div>
          <span class="call-chip shrink-0"><span data-call-timer>00:00</span></span>
        </div>

        <div class="waveform mt-6 h-9 justify-center gap-1" aria-hidden="true">
          <span class="h-3 animate-pulse" style="animation-delay:0ms"></span>
          <span class="h-6 animate-pulse" style="animation-delay:100ms"></span>
          <span class="h-4 animate-pulse" style="animation-delay:200ms"></span>
          <span class="h-9 animate-pulse" style="animation-delay:60ms"></span>
          <span class="h-5 animate-pulse" style="animation-delay:260ms"></span>
          <span class="h-7 animate-pulse" style="animation-delay:160ms"></span>
          <span class="h-3 animate-pulse" style="animation-delay:320ms"></span>
        </div>

        <dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5 border-t border-border pt-5">
          {% for stat in stats.list %}
          <div>
            <dt class="text-xs text-ink/50">{{ stat.label }}</dt>
            <dd class="font-display text-xl font-semibold tracking-tight text-brand" data-count-up data-target="{{ stat.value }}" data-suffix="{{ stat.suffix }}">0{{ stat.suffix }}</dd>
          </div>
          {% endfor %}
        </dl>
      </div>
    </div>

    {# Transcript — everything the call actually covers. #}
    <div class="mt-14 space-y-16 lg:col-span-8 lg:mt-0">

      {# Why us #}
      <div>
        <p class="eyebrow">Why people choose us</p>
        <h2 class="mt-2 font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">A job board can't call you back.</h2>
        <p class="mt-4 leading-relaxed text-ink/65">You're not entering a database. You get one recruiter who owns your search from the first call to the ninety-day check-in.</p>
        <div class="mt-6 space-y-3">
          {% set humanWhy = [
            { icon: "target", t: "Matched by a person, not a filter", d: "Every résumé is read. No keyword screen has ever understood a career change.", time: "0:04" },
            { icon: "shield", t: "Employers we've actually vetted", d: "We've placed people at each partner before. You're not a test case.", time: "0:11" },
            { icon: "bolt", t: "Honest about the odds", d: "If we don't think you'll get the role, we say so on the first call.", time: "0:19" },
            { icon: "support", t: "We stay after the offer", d: "Negotiation help, a first-week check-in, and another at ninety days.", time: "0:27" }
          ] %}
          {% for why in humanWhy %}
          <div class="soft-card flex gap-4 p-5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-brand/10 text-brand">{{ icon(why.icon, "w-4 h-4") }}</span>
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline justify-between gap-3">
                <p class="font-display font-semibold tracking-tight text-ink">{{ why.t }}</p>
                <span class="shrink-0 font-mono text-[11px] text-ink/35">{{ why.time }}</span>
              </div>
              <p class="mt-1 text-sm leading-relaxed text-ink/65">{{ why.d }}</p>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>

      {# Who's on the call #}
      <div>
        <p class="eyebrow">Who's on this call</p>
        <h2 class="mt-2 font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">Two conversations, same recruiter.</h2>
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="soft-card p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-brand text-paper">{{ icon("users", "w-5 h-5") }}</span>
            <h3 class="mt-4 font-display text-lg font-semibold tracking-tight text-ink">Job seekers</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/65">You've sent the applications. Send one conversation instead — we'll take it from there.</p>
            <a href="{{ '/services/job-placement/' | url }}" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand transition-all hover:gap-2.5">Explore job placement {{ icon("arrow-right", "w-4 h-4") }}</a>
          </div>
          <div class="soft-card p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent text-ink">{{ icon("briefcase", "w-5 h-5") }}</span>
            <h3 class="mt-4 font-display text-lg font-semibold tracking-tight text-ink">Employers</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/65">Fewer résumés, better ones. We read the brief and send the three people who fit it.</p>
            <a href="{{ '/services/recruitment-staffing/' | url }}" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand transition-all hover:gap-2.5">Explore hiring services {{ icon("arrow-right", "w-4 h-4") }}</a>
          </div>
        </div>
      </div>

      {# What we help with — a topic list, not a card grid #}
      <div>
        <p class="eyebrow">What we help with</p>
        <h2 class="mt-2 font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">Five services, one pipeline.</h2>
        <div class="mt-6 divide-y divide-border overflow-hidden rounded-2xl border border-border">
          {% for service in services.list %}
          <a href="{{ service.url | url }}" class="group flex items-center gap-4 bg-paper p-5 transition-colors hover:bg-surface sm:p-6">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand transition-colors group-hover:bg-brand group-hover:text-paper">
              {{ icon(service.icon, "w-5 h-5") }}
            </span>
            <div class="min-w-0 flex-1">
              <p class="font-display font-semibold tracking-tight text-ink">{{ service.title }}</p>
              <p class="mt-0.5 text-sm text-ink/60">{{ service.shortDescription }}</p>
            </div>
            <span class="shrink-0 text-ink/30 transition-all group-hover:translate-x-1 group-hover:text-brand">{{ icon("arrow-right", "w-4 h-4") }}</span>
          </a>
          {% endfor %}
        </div>
      </div>

      {# Voicemails — testimonials reframed as messages left after the call #}
      <div>
        <p class="eyebrow">What people say after they hang up</p>
        <h2 class="mt-2 font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">A few voicemails.</h2>
        <div class="mt-6 space-y-4">
          {% set featuredVoicemails = testimonials.list | rejectattr("slug", "equalto", "priya") %}
          {% for testimonial in featuredVoicemails %}
            {% if loop.index <= 3 %}
            <div class="soft-card flex flex-col gap-4 p-6 sm:flex-row sm:items-center">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand text-paper" aria-hidden="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
              <div class="min-w-0 flex-1">
                <p class="leading-relaxed text-ink/80">&ldquo;{{ testimonial.quote }}&rdquo;</p>
                <p class="mt-2 text-sm text-ink/55">{{ testimonial.name }} · {{ testimonial.role }}, {{ testimonial.company }}</p>
              </div>
              <span class="waveform h-6 shrink-0 gap-0.5 self-center" aria-hidden="true">
                <span class="h-2 animate-pulse" style="animation-delay:0ms"></span>
                <span class="h-4 animate-pulse" style="animation-delay:150ms"></span>
                <span class="h-3 animate-pulse" style="animation-delay:300ms"></span>
                <span class="h-5 animate-pulse" style="animation-delay:80ms"></span>
              </span>
            </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {# How the call goes — process, as an inline sequence #}
      <div>
        <p class="eyebrow">How the call goes</p>
        <h2 class="mt-2 font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">Four steps, no mystery.</h2>
        <ol class="mt-6 space-y-1">
          {% set humanSteps = [
            { label: "Say hello", description: "Ten minutes on the phone. Where you are, where you want to be." },
            { label: "We match", description: "Roles and employers that fit the brief — not everything on the board." },
            { label: "You interview", description: "Prep and coaching before every conversation that matters." },
            { label: "You're placed", description: "Offer support, negotiation help, and a check-in at ninety days." }
          ] %}
          {% for step in humanSteps %}
          <li class="flex items-start gap-4 py-4 {% if not loop.last %}border-b border-border{% endif %}">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand font-mono text-xs font-semibold text-paper">{{ loop.index }}</span>
            <div class="min-w-0">
              <p class="font-display font-semibold tracking-tight text-ink">{{ step.label }}</p>
              <p class="mt-0.5 text-sm leading-relaxed text-ink/65">{{ step.description }}</p>
            </div>
          </li>
          {% endfor %}
        </ol>
      </div>
    </div>
  </div>
</section>

{# ---------- 3. Full-width interlude: who answered before ---------- #}
{% set placedAtLayout = "marquee" %}
{% set placedAtTitle = "Candidates placed in" %}
{% set placedAtLead = "People we placed work here now." %}
{% include "partials/placed-at.njk" %}

{# ---------- 4. The signature moment: a call worth recording ---------- #}
<section class="bg-surface py-16 sm:py-24">
  <div class="section-container">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="relative">
        <div class="blob-b photo-frame aspect-[4/5] overflow-hidden shadow-glass">
          <img src="{{ '/assets/images/home/interview-conversation.jpg' | url }}" alt="A candidate meeting a hiring manager"
               width="1400" height="1750" loading="lazy" class="h-full w-full object-cover">
        </div>
        <button type="button" class="glass-panel absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full text-brand" aria-hidden="true" tabindex="-1">
          <svg class="h-6 w-6 translate-x-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <div class="glass-panel absolute -bottom-5 -right-2 rounded-2xl px-5 py-4 sm:-right-6">
          <p class="font-display text-3xl font-semibold tracking-tight text-brand">16 days</p>
          <p class="mt-0.5 text-xs text-ink/55">résumé to signed offer</p>
        </div>
      </div>

      <div>
        <p class="eyebrow">The call worth recording</p>
        <h2 class="mt-3 font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">
          Forty applications, no replies. Then a phone rang.
        </h2>
        <p class="mt-5 leading-relaxed text-ink/70">
          Priya had a strong analytics background and a résumé that buried it on page two. We rebuilt the profile around the work she actually wanted, introduced her to three employers who needed exactly that, and prepped her for every conversation.
        </p>
        <blockquote class="mt-7 border-l-4 border-accent pl-5 font-display text-xl leading-relaxed text-ink">
          &ldquo;The role fit better than anything I'd found on my own.&rdquo;
        </blockquote>
        <div class="mt-7 flex items-center gap-3">
          <img src="{{ '/assets/images/home/person-priya.jpg' | url }}" alt="" width="48" height="48" loading="lazy"
               class="h-12 w-12 rounded-full object-cover">
          <div>
            <p class="font-semibold text-ink">Priya Nandakumar</p>
            <p class="text-sm text-ink/55">Data Analyst, Amazon</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{# ---------- 5. Closer: hand over the phone (bookends the opener) ---------- #}
<section class="relative flex flex-col items-center overflow-hidden px-4 py-20 text-center sm:py-28">
  <span class="orb -left-24 top-0 h-96 w-96 bg-accent/15" aria-hidden="true"></span>
  <span class="orb -right-24 bottom-0 h-96 w-96 bg-brand/12" aria-hidden="true"></span>

  <p class="call-chip">
    <span class="relative flex h-2 w-2">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70 motion-reduce:animate-none"></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
    </span>
    Your turn to call
  </p>

  <h2 class="mx-auto mt-6 max-w-2xl font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-5xl">
    Ready to find your footing?
  </h2>
  <p class="mx-auto mt-5 max-w-lg leading-relaxed text-ink/65">
    Whether you're job hunting or hiring, the first conversation is free — and it's with a person, not a form.
  </p>
  <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
    <a href="{{ '/contact/' | url }}" class="btn-primary">Get Started {{ icon("arrow-right", "w-4 h-4") }}</a>
    <a href="{{ site.phoneHref }}" class="btn-outline">{{ icon("phone", "w-4 h-4") }} {{ site.phone }}</a>
  </div>
</section>

{% include "partials/variant-switcher.njk" %}

<script>
(function () {
  var timers = document.querySelectorAll("[data-call-timer]");
  if (!timers.length || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  var seconds = 0;
  setInterval(function () {
    seconds++;
    var m = Math.floor(seconds / 60);
    var s = seconds % 60;
    var text = (m < 10 ? "0" : "") + m + ":" + (s < 10 ? "0" : "") + s;
    timers.forEach(function (el) { el.textContent = text; });
  }, 1000);
})();
</script>
