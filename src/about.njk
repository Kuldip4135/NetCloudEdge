<section id="facts" class="section-container scroll-mt-28 pb-16 sm:pb-24">
  <h2 class="section-title">The registered particulars.</h2>
  <div class="glass-panel mt-8 p-6 sm:p-8">
    <dl>
      {% set facts = [
        { k: "Trading as", v: site.companyName },
        { k: "Registered as", v: site.legalEntity },
        { k: "Founded", v: site.founded },
        { k: "Office", v: site.address.line1 + ", " + site.address.line2 },
        { k: "Hours", v: site.hours }
      ] %}
      {% for fact in facts %}
      <div class="fact-row">
        <dt class="meta">{{ fact.k }}</dt>
        <dd class="font-grotesk font-semibold tracking-tight text-ink">{{ fact.v }}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
#}

