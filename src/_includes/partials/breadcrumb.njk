{# Params: crumbs [{label, url}] — the last item carries no url.
   A breadcrumb is a file path here, so it is set in mono and separated by a slash. #}
<nav class="filepath" aria-label="Breadcrumb">
  {% for crumb in crumbs %}
    {% if not loop.first %}<span aria-hidden="true">/</span>{% endif %}
    {% if crumb.url %}
      <a href="{{ crumb.url | url }}">{{ crumb.label }}</a>
    {% else %}
      <span class="text-ink" aria-current="page">{{ crumb.label }}</span>
    {% endif %}
  {% endfor %}
</nav>
