{% from "partials/icons.njk" import icon %}
<footer class="bg-ink text-paper/90">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-4 lg:gap-8">
      <div>
        <a href="{{ '/' | url }}" class="font-display text-xl font-semibold text-paper">{{ site.shortName }}</a>
        <p class="mt-3 text-sm text-paper/60 max-w-xs">{{ site.tagline }}</p>
        <div class="flex items-center gap-4 mt-5">
          {% for s in site.social %}
          <a href="{{ s.url | url }}" class="text-paper/60 hover:text-accent transition-colors text-sm">{{ s.label }}</a>
          {% endfor %}
        </div>
      </div>

      <div>
        <h3 class="font-display text-sm tracking-wide uppercase text-paper/50 mb-4">Services</h3>
        <ul class="space-y-2.5 text-sm">
          {% for service in services.list %}
          <li><a href="{{ service.url | url }}" class="text-paper/80 hover:text-accent transition-colors">{{ service.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm tracking-wide uppercase text-paper/50 mb-4">Company</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="{{ '/' | url }}" class="text-paper/80 hover:text-accent transition-colors">Home</a></li>
          <li><a href="{{ '/about/' | url }}" class="text-paper/80 hover:text-accent transition-colors">About</a></li>
          <li><a href="{{ '/contact/' | url }}" class="text-paper/80 hover:text-accent transition-colors">Contact</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm tracking-wide uppercase text-paper/50 mb-4">Contact</h3>
        <ul class="space-y-2.5 text-sm text-paper/80">
          <li class="flex items-start gap-2"><span class="mt-0.5 text-accent">{{ icon("map-pin", "w-4 h-4") }}</span><span>{{ site.address.line1 }}, {{ site.address.line2 }}</span></li>
          <li class="flex items-center gap-2"><span class="text-accent">{{ icon("phone", "w-4 h-4") }}</span><a href="{{ site.phoneHref }}" class="hover:text-accent transition-colors">{{ site.phone }}</a></li>
          <li class="flex items-center gap-2"><span class="text-accent">{{ icon("mail", "w-4 h-4") }}</span><a href="mailto:{{ site.email }}" class="hover:text-accent transition-colors">{{ site.email }}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-paper/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-paper/50">
      <p>&copy; {{ "" | currentYear }} {{ site.companyName }}. All rights reserved.</p>
      <p>{{ site.hours }}</p>
    </div>
  </div>
</footer>
