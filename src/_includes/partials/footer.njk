{% from "partials/icons.njk" import icon %}
{#
  The file's back cover, on ink. Tokens invert here: text is paper / paper-65.
  No newsletter signup — nobody is sending a newsletter. Privacy Policy and Terms are
  deliberately absent until those pages exist (CONTENT.md verification list, item 14).
#}
<footer class="bg-ink text-paper">
  <div class="section-container py-16">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-4 lg:gap-8">

      <div>
        <a href="{{ '/' | url }}" class="font-display text-xl font-semibold tracking-tight text-paper">{{ site.shortName }}</a>
        <p class="mt-3 max-w-xs body-copy text-paper/75">{{ site.tagline }}</p>
        <div class="mt-5 flex items-center gap-4">
          {% for s in site.social %}
          <a href="{{ s.url }}" class="meta text-paper/65 transition-colors hover:text-paper">{{ s.label }}</a>
          {% endfor %}
        </div>
      </div>

      <div>
        <h2 class="meta text-paper/65">Services</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {% for service in services.list %}
          <li><a href="{{ service.url | url }}" class="text-paper/75 transition-colors hover:text-paper">{{ service.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div>
        <h2 class="meta text-paper/65">Company</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="{{ '/' | url }}" class="text-paper/75 transition-colors hover:text-paper">Home</a></li>
          <li><a href="{{ '/about/' | url }}" class="text-paper/75 transition-colors hover:text-paper">About</a></li>
          <li><a href="{{ '/services/' | url }}" class="text-paper/75 transition-colors hover:text-paper">Services</a></li>
          <li><a href="{{ '/contact/' | url }}" class="text-paper/75 transition-colors hover:text-paper">Contact</a></li>
        </ul>
      </div>

      <div>
        <h2 class="meta text-paper/65">Contact</h2>
        <ul class="mt-4 space-y-2.5 text-sm text-paper/75">
          <li class="flex items-start gap-2"><span class="mt-0.5 shrink-0 text-paper/65">{{ icon("map-pin", "w-4 h-4") }}</span><span>{{ site.address.line1 }}, {{ site.address.line2 }}</span></li>
          <li class="flex items-center gap-2"><span class="shrink-0 text-paper/65">{{ icon("phone", "w-4 h-4") }}</span><a href="{{ site.phoneHref }}" class="transition-colors hover:text-paper">{{ site.phone }}</a></li>
          <li class="flex items-center gap-2"><span class="shrink-0 text-paper/65">{{ icon("mail", "w-4 h-4") }}</span><a href="mailto:{{ site.email }}" class="transition-colors hover:text-paper">{{ site.email }}</a></li>
          <li class="flex items-center gap-2"><span class="shrink-0 text-paper/65">{{ icon("clock", "w-4 h-4") }}</span><span>{{ site.hours }}</span></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-dashed border-paper/20 pt-8 meta text-paper/65 sm:flex-row">
      <p>&copy; {{ "" | currentYear }} {{ site.legalEntity }}. All rights reserved.</p>
      <p>Case No. {{ site.caseNumber }} · {{ site.address.line2 }}</p>
    </div>
  </div>
</footer>
