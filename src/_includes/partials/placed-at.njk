{#
  Employer wall, fed from _data/companies.json — a full-bleed interlude breaking out of
  the bento grid rhythm. Wordmarks drift past in a continuous marquee rather than
  sitting in a static grid — the wall should feel like a running tape, not a poster.
  Content is printed twice for a seamless loop; the second copy is aria-hidden and
  dropped under reduced motion (see .marquee-track in input.css). Pauses on
  hover/focus so a moving wall never sits under someone's pointer or keyboard focus.

  Params: placedAtTitle, placedAtLead (optional copy overrides).
#}
<section class="py-10 sm:py-14">
  <div class="section-container">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div class="section-head">
        <p class="eyebrow">{{ placedAtTitle or "Candidates placed in" }}</p>
        <h2 class="section-title">{{ placedAtLead or "Our people work here now." }}</h2>
      </div>
      <p class="max-w-xs meta leading-relaxed">
        A sample of the employers who have hired candidates we placed.
      </p>
    </div>

    <div class="glass-panel marquee-wrap mt-8">
      <div class="marquee-track animate-marquee">
        {% for pass in ["visible", "duplicate"] %}
        <ul class="flex shrink-0 items-stretch {% if pass == "duplicate" %}motion-reduce:hidden{% endif %}" {% if pass == "duplicate" %}aria-hidden="true"{% endif %}>
          {% for company in companies.list %}
          <li class="group flex w-[170px] shrink-0 items-center justify-center border-r border-ink/10 px-6 py-8 transition-colors hover:bg-paper sm:w-[210px]">
            {% if company.domain %}
            <img
              src="https://logo.clearbit.com/{{ company.domain }}?size=160"
              alt="{{ company.name }}"
              width="120" height="40" loading="lazy"
              data-logo-fallback
              data-name="{{ company.name }}"
              data-fallback-class="text-center font-grotesk text-xl font-semibold tracking-tight text-ink/50 transition-colors group-hover:text-brand sm:text-2xl"
              class="h-7 w-auto max-w-[130px] object-contain grayscale transition-all duration-200 group-hover:grayscale-0 sm:h-8"
            >
            {% else %}
            <span class="text-center font-grotesk text-xl font-semibold tracking-tight text-ink/50 transition-colors group-hover:text-brand sm:text-2xl">
              {{ company.name }}
            </span>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
