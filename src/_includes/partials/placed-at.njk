{#
  Employer wall, fed from _data/companies.json — a rigid bordered matrix, the way an
  index of referenced parties would be printed. Wordmarks, not logo files: see the note
  in that data file. DO NOT ship without written permission and a genuine placement at
  each company (CONTENT.md verification list, item 4).

  Params: placedAtTitle, placedAtLead (optional copy overrides).
#}
<section class="file-band py-14 sm:py-20">
  <div class="section-container">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">{{ placedAtTitle or "Candidates placed in" }}</p>
        <h2 class="mt-2 font-display text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">
          {{ placedAtLead or "Our people work here now." }}
        </h2>
      </div>
      <p class="max-w-xs meta leading-relaxed">
        A sample of the employers who have hired candidates we placed.
      </p>
    </div>

    <ul class="mt-8 grid grid-cols-2 border-l border-t border-border sm:grid-cols-3 lg:grid-cols-4">
      {% for company in companies.list %}
      <li class="group flex items-center justify-center border-b border-r border-border px-4 py-7 transition-colors hover:bg-paper">
        <span class="text-center font-display text-xl font-semibold tracking-tight text-ink/65 transition-colors group-hover:text-ink sm:text-2xl">
          {{ company.name }}
        </span>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
