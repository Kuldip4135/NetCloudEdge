{# Params: steps [{label, description}], sectionTitle, sectionEyebrow #}
<section class="py-16 sm:py-24 bg-surface">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <p class="font-mono text-xs tracking-widest uppercase text-brand">{{ sectionEyebrow or "How it works" }}</p>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold text-ink mt-2">{{ sectionTitle or "The process" }}</h2>
    </div>

    <div class="relative">
      <svg class="hidden lg:block absolute left-0 right-0 top-6 w-full h-3" viewBox="0 0 1000 12" preserveAspectRatio="none" aria-hidden="true">
        <path data-path-draw d="M10 6 L990 6" fill="none" style="stroke: rgb(var(--color-accent))" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round"/>
      </svg>

      <ol class="flex flex-col gap-8 lg:flex-row lg:gap-6">
        {% for step in steps %}
        <li class="relative flex lg:flex-col gap-4 lg:gap-0 lg:flex-1 lg:text-center">
          <div class="relative shrink-0 lg:mx-auto">
            {% if not loop.last %}
            <span class="lg:hidden absolute left-1/2 top-12 -translate-x-1/2 w-px h-[calc(100%+2rem)] bg-border" aria-hidden="true"></span>
            {% endif %}
            <span class="relative z-10 flex items-center justify-center w-14 h-14 rounded-full glass-panel border-brand/30 font-mono font-semibold text-brand shadow-glow">
              {{ "0" if loop.index < 10 else "" }}{{ loop.index }}
            </span>
          </div>
          <div class="pb-2 lg:pt-5 lg:px-3">
            <h3 class="font-display text-lg font-semibold text-ink">{{ step.label }}</h3>
            <p class="mt-1.5 text-sm text-ink/65 leading-relaxed">{{ step.description }}</p>
          </div>
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>
