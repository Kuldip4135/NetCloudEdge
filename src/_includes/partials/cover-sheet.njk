{#
  Hero — per PRD.md: one static headline (no carousel), subhead, two CTAs, a trust
  line, image stacks below text on mobile. Text and CTA column left, a real
  photograph in a glass frame right — image drops below the text in source order,
  so it stacks correctly on mobile with no extra markup.

  Params:
    crumbs          — optional [{label, url}] breadcrumb, printed above the status chip
    coverStamp      — status chip wording ("Intake open", "System status — live", …)
    coverMeta       — small mono line beside the chip; defaults to the address
    coverTitle      — H1, a plain declarative sentence
    coverLead       — lead paragraph
    coverNote       — optional small print under the buttons (e.g. the fee model)
    coverPrimary    — { label, href }
    coverSecondary  — optional { label, href }
    coverStats      — optional [{value, suffix, label}], defaults to stats.list.slice(0,3)
    coverImage      — { src, alt }
#}
{% from "partials/icons.njk" import icon %}
<section>
  <div class="section-container py-10 sm:py-14">
    {% if crumbs %}
      {% include "partials/breadcrumb.njk" %}
    {% endif %}

    <div class="grid grid-cols-1 gap-8 {% if crumbs %}mt-6{% endif %} lg:grid-cols-12 lg:items-center lg:gap-10">
      <div class="lg:col-span-6">
        <div class="flex flex-wrap items-center gap-3">
          <span class="status-chip"><span class="status-dot"></span>{{ coverStamp }}</span>
          <span class="font-mono text-xs uppercase tracking-widest text-ink/65">
            {{ coverMeta or (site.address.line1 + " · " + site.address.line2) }}
          </span>
        </div>

        <h1 class="mt-6 font-grotesk text-3xl font-bold leading-[1.1] tracking-tight text-ink sm:text-5xl lg:text-6xl">
          {{ coverTitle }}
        </h1>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink/65">{{ coverLead }}</p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href="{{ coverPrimary.href | url }}" class="btn-primary">{{ icon("arrow-right", "w-4 h-4") }} {{ coverPrimary.label }}</a>
          {% if coverSecondary %}
          <a href="{{ coverSecondary.href | url }}" class="btn-outline">{{ icon("arrow-right", "w-4 h-4") }} {{ coverSecondary.label }}</a>
          {% endif %}
        </div>

        {% if coverNote %}
        <p class="mt-5 meta leading-relaxed">{{ coverNote }}</p>
        {% endif %}

        <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-ink/10 pt-6">
          {% for stat in (coverStats or stats.list.slice(0, 3)) %}
          <div>
            <dd class="stat-figure text-xl sm:text-2xl" data-count-up data-target="{{ stat.value }}" data-suffix="{{ stat.suffix }}">0{{ stat.suffix }}</dd>
            <dt class="stat-label">{{ stat.label }}</dt>
          </div>
          {% endfor %}
        </dl>
      </div>

      {% if coverImage %}
      <div class="lg:col-span-6">
        <div class="glass-panel p-3">
          <img src="{{ coverImage.src | url }}" alt="{{ coverImage.alt }}"
               width="1200" height="960" loading="eager" fetchpriority="high"
               class="aspect-[5/4] w-full rounded-[1.4rem] object-cover">
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</section>
