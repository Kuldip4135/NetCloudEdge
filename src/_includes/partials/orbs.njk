{#
  The fixed background "light" every glass panel blurs. Included once in base.njk,
  behind all content (-z-10), so it stays visible through every panel as the page
  scrolls. Two orbs float independently (12s/14s), a third stays still for depth.
  A faint schematic grid sits over the top of the hero, with a slow glowing beam
  sweeping down through it — the console reading as an instrument panel.
#}
<div class="bg-orbs" aria-hidden="true">
  <div class="bg-grid">
    <div class="bg-grid-beam"></div>
  </div>
  <div class="orb left-[-8rem] top-[-6rem] h-[26rem] w-[26rem] animate-orb-float-slow bg-brand/20"></div>
  <div class="orb bottom-[-10rem] right-[-6rem] h-[30rem] w-[30rem] animate-orb-float-slower bg-accent/20"></div>
  <div class="orb left-1/3 top-1/2 h-[22rem] w-[22rem] bg-brand/10"></div>
</div>
