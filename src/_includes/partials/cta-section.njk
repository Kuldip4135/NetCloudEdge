{#
  Params: ctaHeadline, ctaSubtext (optional), ctaLabel, ctaHref, ctaVariant ("brand" | "accent")
#}
<section class="relative {% if ctaVariant == 'accent' %}bg-gradient-to-br from-accent via-accent to-[#c96b28]{% else %}bg-gradient-to-br from-brand via-brand to-brand-dark{% endif %} py-20 sm:py-24 overflow-hidden">
  <span class="orb w-96 h-96 -top-32 left-1/4 bg-paper/10 animate-float" aria-hidden="true"></span>
  <span class="orb w-72 h-72 -bottom-24 right-10 bg-paper/10 animate-float-delayed" aria-hidden="true"></span>
  <div class="relative max-w-content mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold text-paper max-w-2xl mx-auto text-balance">{{ ctaHeadline }}</h2>
    {% if ctaSubtext %}
    <p class="mt-3 text-paper/85 max-w-xl mx-auto">{{ ctaSubtext }}</p>
    {% endif %}
    <a href="{{ ctaHref | url }}" class="inline-block mt-8 bg-paper text-ink font-medium px-8 py-3.5 rounded-full shadow-glass hover:-translate-y-0.5 hover:shadow-lg transition-all duration-200">{{ ctaLabel }}</a>
  </div>
</section>
