{#
  The sticky left rail of the page shell. Every section listed here must exist on the
  page with a matching id and scroll-mt-28.

  Params:
    rail      — [{ id, label, n }]
    railCard  — optional { title, rows: [{k, v}], cta: {label, href} } pinned under the
                links. For terms an employer wants held in view. Never put a rate in it.
    railStats — true to print the shared stat figures under the links (Home / About only,
                and only where /assets/js/count-up.js is loaded)
  Hidden below lg: on mobile the document column is read straight through.
#}
{% from "partials/icons.njk" import icon %}
<nav class="hidden lg:col-span-3 lg:block" aria-label="Sections">
  <div class="folder-card sticky top-28 p-2">
    {% for item in rail %}
    <a href="#{{ item.id }}" data-rail-link class="rail-link">
      <span class="font-mono text-[11px] text-ink/65">{{ item.n }}</span>{{ item.label }}
    </a>
    {% endfor %}

    {% if railCard %}
    {# Terms held in view for the whole scroll. Recruitment & Staffing only: an employer
       skimming for commercial terms is better served by the terms themselves than by a
       second table of contents. Structure only — never a rate. #}
    <div class="mt-1 border-t border-dashed border-border px-3 pb-1 pt-4">
      <p class="meta">{{ railCard.title }}</p>
      <dl class="mt-3 space-y-3">
        {% for row in railCard.rows %}
        <div class="flex flex-col-reverse">
          <dt class="mt-0.5 meta">{{ row.k }}</dt>
          <dd class="text-sm font-medium leading-snug text-ink">{{ row.v }}</dd>
        </div>
        {% endfor %}
      </dl>
      {% if railCard.cta %}
      <a href="{{ railCard.cta.href | url }}" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand transition-all hover:gap-2.5">
        {{ railCard.cta.label }} {{ icon("arrow-right", "w-4 h-4") }}
      </a>
      {% endif %}
    </div>
    {% endif %}

    {% if railStats %}
    <div class="mt-1 border-t border-dashed border-border px-3 pt-4">
      <dl class="grid grid-cols-2 gap-y-4">
        {% for stat in stats.list %}
        <div class="flex flex-col-reverse">
          <dt class="mt-1 meta">{{ stat.label }}</dt>
          <dd class="font-mono text-lg font-semibold tracking-tight text-ink"
              data-count-up data-target="{{ stat.value }}" data-suffix="{{ stat.suffix }}">0{{ stat.suffix }}</dd>
        </div>
        {% endfor %}
      </dl>
    </div>
    {% endif %}
  </div>
</nav>
