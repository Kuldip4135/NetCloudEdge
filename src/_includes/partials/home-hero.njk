{#
  Home hero — centred, full-width, image beneath rather than beside.

  Distinct from partials/cover-sheet.njk, which the four service pages use: those are
  left-text / right-image splits, because a service page opens mid-conversation with a
  reader who already chose a door. Home opens before that choice is made, so the
  headline gets the full measure of the page and both doors sit side by side under it,
  neither one visually favoured.

  The ground is a scoped exception to THE LEDGER's no-glow rule (see the .hero-aurora
  note in input.css): three soft brand fields drift on offset loops behind the copy,
  with a crisp centre-lit dot field over the top. This is the ONE screen allowed the
  bloom — it has no component on it to stay consistent with. Every other page keeps
  the flat .bg-orbs texture. Motion is transform-only and collapses under
  prefers-reduced-motion to a static hold.

  The image sits below the fold-line copy as a wide band, so the hero's first screen is
  headline + CTAs on mobile and desktop alike.
#}
{% from "partials/icons.njk" import icon %}
{# data-rotator-scope marks the region whose hover / keyboard focus pauses the rotator. #}
<section data-rotator-scope class="relative overflow-hidden">

  {# Decorative ground. aria-hidden — it carries no information. #}
  <div class="hero-aurora" aria-hidden="true">
    <span class="aurora-blob aurora-blob-1"></span>
    <span class="aurora-blob aurora-blob-2"></span>
    <span class="aurora-blob aurora-blob-3"></span>
  </div>
  <div class="hero-dots" aria-hidden="true"></div>

  <div class="section-container pb-12 pt-14 sm:pb-16 sm:pt-20 lg:pt-24">

    <div class="section-head is-centered max-w-4xl">
      <p class="meta">{{ site.address.line1 }} · {{ site.address.line2 }}</p>

      {# The rotating audience word. The <h1>'s accessible text is the complete
         sentence in a visually-hidden span; the visible half is aria-hidden
         presentation of that same sentence. The track renders with the first word
         already in the mask, so the hero is correct before text-rotator.js runs and
         if it never does. #}
      {% set rotatorWords = ["students", "professionals", "employers"] %}

      <h1 class="mt-3">
        <span class="sr-only">
          Recruiting for students starting out, professionals moving on, and the employers hiring both.
        </span>

        <span aria-hidden="true" class="display-title block">
          <span class="block">Recruiting for</span>

          {# data-hold — milliseconds each word holds still before the next rolls up.
             The roll itself takes another 400ms (.roll-track in input.css).
             hold 1800 + roll 400 ≈ 2200ms per word. #}
          <span data-rotator data-hold="1800" class="roll-mask">
            <span data-rotator-track class="roll-track">
              {% for word in rotatorWords %}
              <span data-rotator-word class="roll-word">{{ word }}</span>
              {% endfor %}
              <span data-rotator-word data-rotator-clone class="roll-word">{{ rotatorWords[0] }}</span>
            </span>
          </span>
        </span>

      </h1>

      <p class="lead-copy mx-auto max-w-2xl">
        Two doors, one team behind both — matched by people who read the brief,
        not a keyword filter.
      </p>

      {# Two doors, equal weight. The solid/outline pairing distinguishes them without
         ranking them. #}
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="{{ '/services/job-placement/' | url }}" class="btn-primary">
          {{ icon("users", "w-4 h-4") }} Find a job
        </a>
        <a href="{{ '/services/recruitment-staffing/' | url }}" class="btn-outline">
          {{ icon("briefcase", "w-4 h-4") }} Hire talent
        </a>
      </div>

      <p class="meta mt-6">Free for candidates — employers pay our fee.</p>
    </div>

    <figure class="relative mt-12 sm:mt-16">
      <img src="{{ '/assets/images/home/hero-team-meeting.jpg' | url }}"
           alt="A recruiter and a candidate in conversation"
           width="2400" height="1000" loading="eager" fetchpriority="high"
           class="aspect-[16/10] w-full rounded-2xl object-cover shadow-card sm:aspect-[21/9]">

      {# Editorial annotations — a measurement scale under the photo, naming what the
         team actually does. Decorative: a compact stacked list on mobile, one hairline
         rule with three ticks on sm+. aria-hidden — it restates the process below. #}
      <div class="hero-notes" aria-hidden="true">
        {% for note in ["Read the brief", "Find the fit", "Stay through the offer"] %}
        <span class="hero-note">
          <span class="hero-note-index">0{{ loop.index }}</span>
          <span class="hero-note-label">{{ note }}</span>
        </span>
        {% endfor %}
      </div>

      {# TODO — Hero stat strip gated. stats.json is placeholder ("confirm every
         figure with the client before launch"). Restore the figcaption below, and
         add /assets/js/count-up.js back to index.njk's extraScripts, once the
         numbers are real and confirmed.
      <figcaption class="glass-panel hero-stat-strip relative z-10 mx-auto -mt-8 grid max-w-5xl grid-cols-2 gap-px overflow-hidden bg-border p-0 sm:-mt-12 md:grid-cols-4 lg:-mt-16">
        {% for stat in stats.list %}
        <div class="bg-surface px-5 py-6 text-center sm:px-6 sm:py-7">
          <p class="stat-figure text-2xl sm:text-3xl"
             data-count-up data-target="{{ stat.value }}" data-suffix="{{ stat.suffix }}">0{{ stat.suffix }}</p>
          <p class="stat-label">{{ stat.label }}</p>
        </div>
        {% endfor %}
      </figcaption>
      #}
    </figure>
  </div>
</section>
