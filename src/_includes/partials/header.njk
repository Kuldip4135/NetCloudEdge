{% from "partials/icons.njk" import icon %}
{#
  The file's cover: a flat bar on the paper stock that picks up a hairline bottom border
  once scrolled (header-scroll.js), never a shadow. The services dropdown opens on hover
  AND on keyboard focus — group-focus-within is what makes it keyboard-reachable.
#}
<header data-header class="sticky top-0 z-50 border-b border-transparent bg-paper transition-colors">
  <div class="section-container">
    <div class="flex h-16 items-center justify-between lg:h-20">
      <a href="{{ '/' | url }}" class="flex shrink-0 items-baseline gap-2.5">
        <span class="font-display text-xl font-semibold tracking-tight text-ink lg:text-2xl">{{ site.shortName }}</span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        {% for link in nav.links %}
          {% if link.children %}
          <div class="group relative">
            <a href="{{ link.url | url }}" class="flex items-center gap-1 rounded-sm px-4 py-2 text-sm font-medium text-ink transition-colors hover:text-brand" aria-haspopup="true">
              {{ link.label }}
              {{ icon("chevron-down", "w-4 h-4") }}
            </a>
            <div class="invisible absolute left-1/2 top-full w-[420px] -translate-x-1/2 pt-3 opacity-0 transition-[opacity,visibility] duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="grid grid-cols-2 gap-1 rounded-sm border border-border bg-paper p-3">
                {% for child in link.children %}
                <a href="{{ child.url | url }}" class="flex items-center gap-3 rounded-sm px-3 py-2.5 text-sm text-ink transition-colors hover:bg-surface">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-sm bg-surface text-brand">{{ icon(child.icon, "w-4 h-4") }}</span>
                  {{ child.label }}
                </a>
                {% endfor %}
              </div>
            </div>
          </div>
          {% else %}
          <a href="{{ link.url | url }}" class="rounded-sm px-4 py-2 text-sm font-medium text-ink transition-colors hover:text-brand">{{ link.label }}</a>
          {% endif %}
        {% endfor %}
      </nav>

      <div class="hidden shrink-0 lg:block">
        <a href="{{ '/contact/' | url }}" class="btn-primary">Get Started</a>
      </div>

      {# On mobile the header CTA becomes a click-to-call link. #}
      <div class="flex items-center gap-3 lg:hidden">
        <a href="{{ site.phoneHref }}" class="text-ink" aria-label="Call {{ site.companyName }}">{{ icon("phone", "w-5 h-5") }}</a>
        {# Three bars that rotate into an X — see .nav-burger; state is driven off aria-expanded. #}
        <button type="button" data-mobile-menu-toggle aria-expanded="false" aria-controls="mobile-menu" class="nav-burger">
          <span class="nav-burger-bar"></span><span class="nav-burger-bar"></span><span class="nav-burger-bar"></span>
          <span class="sr-only" data-mobile-menu-label>Open menu</span>
        </button>
      </div>
    </div>
  </div>
</header>

<div id="mobile-menu" data-mobile-menu class="mobile-menu">
  <nav class="flex flex-col gap-1 px-4 py-6" aria-label="Mobile">
    {% for link in nav.links %}
      {% if link.children %}
      <div data-mobile-accordion>
        <button type="button" data-mobile-accordion-trigger class="flex w-full items-center justify-between border-b border-dashed border-border px-3 py-3 text-base font-medium text-ink" aria-expanded="false">
          {{ link.label }}
          {{ icon("chevron-down", "w-5 h-5 transition-transform") }}
        </button>
        <div data-mobile-accordion-panel class="hidden flex-col gap-1 pb-2 pl-3">
          {% for child in link.children %}
          <a href="{{ child.url | url }}" class="flex items-center gap-3 rounded-sm px-3 py-2.5 text-sm text-ink/75 hover:bg-surface">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-sm bg-surface text-brand">{{ icon(child.icon, "w-3.5 h-3.5") }}</span>
            {{ child.label }}
          </a>
          {% endfor %}
        </div>
      </div>
      {% else %}
      <a href="{{ link.url | url }}" class="border-b border-dashed border-border px-3 py-3 text-base font-medium text-ink">{{ link.label }}</a>
      {% endif %}
    {% endfor %}
    <a href="{{ '/contact/' | url }}" class="btn-primary mt-5 w-full">Get Started</a>
  </nav>
</div>
