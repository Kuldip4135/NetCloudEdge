{% from "partials/icons.njk" import icon %}
<header data-header class="sticky top-0 z-50 bg-paper/95 backdrop-blur border-b border-transparent transition-colors">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <a href="{{ '/' | url }}" class="font-display text-xl lg:text-2xl font-semibold text-ink shrink-0">
        {{ site.shortName }}
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
        {% for link in nav.links %}
          {% if link.children %}
          <div class="relative group" data-dropdown>
            <button type="button" class="flex items-center gap-1 px-4 py-2 rounded-full text-sm font-medium text-ink hover:text-brand transition-colors" aria-expanded="false" aria-haspopup="true">
              {{ link.label }}
              {{ icon("chevron-down", "w-4 h-4") }}
            </button>
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 w-[420px] opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-150">
              <div class="bg-paper border border-border rounded-2xl shadow-lg shadow-ink/5 p-3 grid grid-cols-2 gap-1">
                {% for child in link.children %}
                <a href="{{ child.url | url }}" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-ink hover:bg-surface transition-colors">
                  <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-surface text-brand shrink-0">{{ icon(child.icon, "w-4 h-4") }}</span>
                  {{ child.label }}
                </a>
                {% endfor %}
              </div>
            </div>
          </div>
          {% else %}
          <a href="{{ link.url | url }}" class="px-4 py-2 rounded-full text-sm font-medium text-ink hover:text-brand transition-colors">{{ link.label }}</a>
          {% endif %}
        {% endfor %}
      </nav>

      <div class="hidden lg:block shrink-0">
        <a href="{{ '/contact/' | url }}" class="btn-primary">Get Started</a>
      </div>

      <div class="flex items-center gap-3 lg:hidden">
        <a href="{{ site.phoneHref }}" class="text-ink" aria-label="Call {{ site.companyName }}">{{ icon("phone", "w-5 h-5") }}</a>
        <button type="button" data-mobile-menu-toggle aria-expanded="false" aria-controls="mobile-menu" class="p-2 -mr-2 text-ink">
          {{ icon("menu", "w-6 h-6") }}
          <span class="sr-only">Open menu</span>
        </button>
      </div>
    </div>
  </div>
</header>

<div id="mobile-menu" data-mobile-menu class="hidden lg:hidden fixed inset-0 top-16 z-40 bg-paper overflow-y-auto">
  <nav class="px-4 py-6 flex flex-col gap-1" aria-label="Mobile">
    {% for link in nav.links %}
      {% if link.children %}
      <div data-mobile-accordion>
        <button type="button" data-mobile-accordion-trigger class="w-full flex items-center justify-between px-3 py-3 text-base font-medium text-ink" aria-expanded="false">
          {{ link.label }}
          {{ icon("chevron-down", "w-5 h-5 transition-transform") }}
        </button>
        <div data-mobile-accordion-panel class="hidden pl-3 pb-2 flex flex-col gap-1">
          {% for child in link.children %}
          <a href="{{ child.url | url }}" class="flex items-center gap-3 px-3 py-2.5 text-sm text-ink/80 rounded-lg hover:bg-surface">
            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-surface text-brand shrink-0">{{ icon(child.icon, "w-3.5 h-3.5") }}</span>
            {{ child.label }}
          </a>
          {% endfor %}
        </div>
      </div>
      {% else %}
      <a href="{{ link.url | url }}" class="px-3 py-3 text-base font-medium text-ink">{{ link.label }}</a>
      {% endif %}
    {% endfor %}
    <a href="{{ '/contact/' | url }}" class="btn-primary w-full text-center mt-4">Get Started</a>
  </nav>
</div>
