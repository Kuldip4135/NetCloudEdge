{#
  Params: faqKey — looks up faqs.json[faqKey]. faqTitle / faqEyebrow optional.
  faqNumbered — truthy to prefix each question with a mono 01–NN index (Contact).
  Requires /assets/js/faq-accordion.js in the page's extraScripts.
  Each question is a dashed docket line that opens; keyboard and touch operable via the
  native <button>.
#}
{% from "partials/icons.njk" import icon %}
<section id="faq" class="scroll-mt-28 py-14 sm:py-20">
  <div class="section-container">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">{{ faqEyebrow or "Standing questions" }}</p>
      <h2 class="mt-2 font-display text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">
        {{ faqTitle or "On the record" }}
      </h2>

      <div class="mt-6 border-t border-border">
        {% for item in faqs[faqKey] %}
        <div data-accordion-item class="docket-disclosure">
          <button type="button" data-accordion-trigger aria-expanded="false" aria-controls="faq-{{ faqKey }}-{{ loop.index }}">
            <span class="flex items-baseline gap-3">
              {% if faqNumbered %}<span class="shrink-0 font-mono text-xs font-semibold text-ink/35" aria-hidden="true">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>{% endif %}
              <span>{{ item.q }}</span>
            </span>
            <span class="shrink-0 text-ink/65 transition-transform" data-accordion-icon aria-hidden="true">
              {{ icon("chevron-down", "w-5 h-5") }}
            </span>
          </button>
          <div id="faq-{{ faqKey }}-{{ loop.index }}" data-accordion-panel class="hidden pb-4 body-copy">
            {{ item.a }}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
