{#
  The case log — recent placement activity from _data/placements.json, printed as a
  manifest inside a glass panel. The "this is a living system" signal.

  PLACEHOLDER DATA: needs real, consented placements before launch (CONTENT.md
  verification list, item 5). Never add salary figures to these rows. The footnote about
  shortened names stays — it explains them honestly.
#}
{% from "partials/icons.njk" import icon %}
<section class="py-14 sm:py-20">
  <div class="section-container">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow"><span class="status-dot mr-1.5 align-middle"></span>Manifest · Updated hourly</p>
        <h2 class="mt-2 font-grotesk text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">
          Placements moved this month.
        </h2>
      </div>
      <a href="{{ '/contact/' | url }}" class="inline-flex items-center gap-2 text-sm font-semibold text-brand transition-all hover:gap-3">
        Open yours {{ icon("arrow-right", "w-4 h-4") }}
      </a>
    </div>

    <div class="glass-panel mt-8 p-6 sm:p-8">
      <div class="manifest-head">
        <span class="col-span-4">Candidate</span>
        <span class="col-span-3">Employer</span>
        <span class="col-span-3">Stage</span>
        <span class="col-span-2 text-right">Logged</span>
      </div>
      <ul>
        {% for placement in placements.list %}
        <li class="manifest-row {% if loop.first %}bg-accent/5 -mx-3 rounded-xl px-3{% endif %}">
          <div class="col-span-7 sm:col-span-4">
            <p class="font-grotesk font-semibold tracking-tight text-ink">{{ placement.name }}</p>
            <p class="mt-0.5 text-sm text-ink/55">{{ placement.role }}</p>
          </div>
          <p class="col-span-5 font-grotesk font-semibold tracking-tight text-ink sm:col-span-3">{{ placement.company }}</p>
          <div class="col-span-7 sm:col-span-3">
            {% if placement.status == "Placed" %}
            <span class="status-chip"><span class="status-dot"></span>Closed</span>
            {% else %}
            <span class="file-tag">{{ placement.status }}</span>
            {% endif %}
          </div>
          <p class="col-span-5 text-right sm:col-span-2">
            {% if loop.first %}
            <span class="inline-flex items-center gap-1.5 meta text-accent-deep"><span class="status-dot"></span>{{ placement.when }}</span>
            {% else %}
            <span class="meta">{{ placement.when }}</span>
            {% endif %}
          </p>
        </li>
        {% endfor %}
      </ul>
    </div>

    <p class="mt-5 meta leading-relaxed">
      Names shortened at candidates' request.
    </p>
  </div>
</section>
