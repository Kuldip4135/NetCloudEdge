{#
  Param: testimonial (a _data/testimonials.json entry).
  A sworn statement in the file: a folder with the attribution on a dashed rule beneath.
  Photos in the repo are stock, so the avatar falls back to initials — see the note in
  _data/testimonials.json before shipping a face next to a quote.
#}
<figure class="folder-card flex h-full flex-col p-5">
  <blockquote class="flex-1 body-copy">&ldquo;{{ testimonial.quote }}&rdquo;</blockquote>
  <figcaption class="mt-4 flex items-center justify-between gap-3 border-t border-dashed border-border pt-4">
    <span class="flex items-center gap-3">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-sm bg-surface font-mono text-xs font-semibold text-ink" aria-hidden="true">{{ testimonial.initials }}</span>
      <span>
        <span class="block text-sm font-semibold text-ink">{{ testimonial.name }}</span>
        <span class="block text-xs text-ink/65">{{ testimonial.role }} · {{ testimonial.company }}</span>
      </span>
    </span>
    <span class="shrink-0 meta">Sworn</span>
  </figcaption>
</figure>
