{#
  Param: testimonial (a _data/testimonials.json entry).
  A signed statement inside a glass panel, attribution on a hairline beneath. Photos in
  the repo are stock, so the avatar falls back to initials — see the note in
  _data/testimonials.json before shipping a face next to a quote.
#}
<figure class="glass-panel card-lift flex h-full flex-col p-5 sm:p-6">
  <blockquote class="flex-1 body-copy">&ldquo;{{ testimonial.quote }}&rdquo;</blockquote>
  <figcaption class="mt-4 flex items-center justify-between gap-3 border-t border-ink/10 pt-4">
    <span class="flex items-center gap-3">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-surface font-mono text-xs font-semibold text-ink" aria-hidden="true">{{ testimonial.initials }}</span>
      <span>
        <span class="block text-sm font-semibold text-ink">{{ testimonial.name }}</span>
        <span class="block text-xs text-ink/55">{{ testimonial.role }} · {{ testimonial.company }}</span>
      </span>
    </span>
    <span class="status-dot shrink-0"></span>
  </figcaption>
</figure>
