{% from "partials/icons.njk" import icon %}
{# Param: testimonial {name, role, initials, quote} #}
<div class="relative shrink-0 w-[85vw] sm:w-[420px] lg:w-auto snap-start glass-panel rounded-[1.75rem] p-7 pt-6 flex flex-col overflow-hidden card-lift">
  <span class="absolute -top-3 right-5 font-display text-7xl text-brand/10 select-none leading-none" aria-hidden="true">&rdquo;</span>
  <div class="relative flex items-center gap-1 text-accent">
    {{ icon("star", "w-3.5 h-3.5") }}{{ icon("star", "w-3.5 h-3.5") }}{{ icon("star", "w-3.5 h-3.5") }}{{ icon("star", "w-3.5 h-3.5") }}{{ icon("star", "w-3.5 h-3.5") }}
  </div>
  <p class="relative text-ink/80 leading-relaxed flex-1 mt-4 font-display text-lg">&ldquo;{{ testimonial.quote }}&rdquo;</p>
  <div class="relative flex items-center gap-3 mt-6 pt-5 border-t border-border/70">
    {% if testimonial.photo %}
    <img src="{{ testimonial.photo | url }}" alt="" width="44" height="44" loading="lazy"
         class="w-11 h-11 rounded-full object-cover shrink-0 ring-2 ring-paper shadow-glow">
    {% else %}
    <span class="flex items-center justify-center w-11 h-11 rounded-full bg-ink text-paper font-mono text-sm font-semibold shrink-0 shadow-glow">{{ testimonial.initials }}</span>
    {% endif %}
    <div>
      <p class="font-medium text-ink text-sm">{{ testimonial.name }}</p>
      <p class="text-ink/55 text-xs">{{ testimonial.role }}{% if testimonial.company %} · {{ testimonial.company }}{% endif %}</p>
    </div>
  </div>
</div>
