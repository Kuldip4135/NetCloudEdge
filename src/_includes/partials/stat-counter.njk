{#
  Stat band, fed from _data/stats.json so Home and About can never disagree. Per
  PRD.md: four counters, 2x2 on mobile, one row on desktop. Figures are set in the
  mono face inside glass tiles — a running total on the console, not a badge.
  Requires /assets/js/count-up.js in the page's extraScripts.

  Params: statsTitle, statsEyebrow, statsNote (all optional).
#}
<section class="py-14 sm:py-20">
  <div class="section-container">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">{{ statsEyebrow or "Live totals" }}</p>
        <h2 class="mt-2 font-grotesk text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">
          {{ statsTitle or "What's running right now." }}
        </h2>
      </div>
      <p class="max-w-xs meta leading-relaxed">
        {{ statsNote or "Figures under review · updated quarterly" }}
      </p>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
      {% for stat in stats.list %}
      <div class="glass-panel card-lift px-5 py-7">
        <dd class="stat-figure text-3xl sm:text-4xl"
            data-count-up data-target="{{ stat.value }}" data-suffix="{{ stat.suffix }}">0{{ stat.suffix }}</dd>
        <dt class="stat-label">{{ stat.label }}</dt>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
