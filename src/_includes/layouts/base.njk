<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — {{ site.companyName }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="data:,">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.companyName }}">
  <meta property="og:title" content="{{ title }} — {{ site.companyName }}">
  <meta property="og:description" content="{{ description or site.description }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {# Space Grotesk (headings), Public Sans (body), IBM Plex Mono (status/labels/stats). #}
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
</head>
{# `is-glass` switches on the glass system (claude_helper/THEME.md): the ambient colour
   field plus pane density for every .glass-panel on the page. A page opts in with
   `glass: true` in its front matter, so the rollout is one line per page and a page
   that has not been converted keeps the solid-card theme untouched. #}
<body class="bg-paper font-body text-ink antialiased{% if glass %} is-glass{% endif %}">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-paper">
    Skip to content
  </a>

  {% include "partials/orbs.njk" %}
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}

  <script src="{{ '/assets/js/header-scroll.js' | url }}" defer></script>
  <script src="{{ '/assets/js/nav-toggle.js' | url }}" defer></script>
  {% for script in extraScripts %}
  <script src="{{ script | url }}" defer></script>
  {% endfor %}
</body>
</html>
