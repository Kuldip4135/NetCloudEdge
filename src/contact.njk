---
layout: layouts/page.njk
title: Contact
description: Whether you're looking for a job or looking to hire, we're here to help.
extraScripts:
  - /assets/js/contact-form.js
  - /assets/js/faq-accordion.js
---
{% from "partials/icons.njk" import icon %}

<section class="bg-surface py-14 sm:py-20">
  <div class="section-container">
    {% set crumbs = [{ label: "Home", url: "/" }, { label: "Contact" }] %}
    {% include "partials/breadcrumb.njk" %}
    <h1 class="font-display text-4xl sm:text-5xl font-semibold text-ink mt-4">Contact Us</h1>
    <p class="mt-3 text-lg text-ink/65 max-w-xl">Whether you're looking for a job or looking to hire, we're here to help.</p>
  </div>
</section>

<section class="py-16 sm:py-24">
  <div class="section-container">
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-12">

      <div class="lg:w-3/5">
        <form data-contact-form class="bg-paper" novalidate>
          <fieldset class="mb-8">
            <legend class="font-display text-lg font-semibold text-ink mb-3">I am a…</legend>
            <div class="flex flex-wrap gap-3">
              {% set roles = [
                { value: "job-seeker", label: "Job Seeker" },
                { value: "employer", label: "Employer" },
                { value: "training-applicant", label: "Training Applicant" }
              ] %}
              {% for role in roles %}
              <label class="cursor-pointer">
                <input type="radio" name="role" value="{{ role.value }}" data-role-option class="peer sr-only" {% if loop.first %}checked{% endif %} required>
                <span class="inline-block px-5 py-2.5 rounded-full border-2 border-border text-sm font-medium text-ink/70 peer-checked:border-brand peer-checked:bg-brand peer-checked:text-paper peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-accent peer-focus-visible:outline-offset-2 transition-colors">{{ role.label }}</span>
              </label>
              {% endfor %}
            </div>
          </fieldset>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-ink mb-1.5">Full name</label>
              <input type="text" id="name" name="name" required class="w-full rounded-lg border border-border bg-paper px-4 py-2.5 text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-ink mb-1.5">Email</label>
              <input type="email" id="email" name="email" required class="w-full rounded-lg border border-border bg-paper px-4 py-2.5 text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
            </div>
          </div>

          <div class="mt-5" data-role-field="employer">
            <label for="company" class="block text-sm font-medium text-ink mb-1.5">Company name</label>
            <input type="text" id="company" name="company" class="w-full rounded-lg border border-border bg-paper px-4 py-2.5 text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
          </div>

          <div class="mt-5" data-role-field="job-seeker">
            <label for="resume" class="block text-sm font-medium text-ink mb-1.5">Resume upload</label>
            <input type="file" id="resume" name="resume" accept=".pdf,.doc,.docx" class="w-full rounded-lg border border-border bg-paper px-4 py-2.5 text-ink text-sm file:mr-4 file:py-1.5 file:px-3 file:rounded-full file:border-0 file:bg-surface file:text-ink file:text-sm">
          </div>

          <div class="mt-5" data-role-field="training-applicant">
            <label for="track" class="block text-sm font-medium text-ink mb-1.5">Which track interests you?</label>
            <select id="track" name="track" class="w-full rounded-lg border border-border bg-paper px-4 py-2.5 text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
              {% for program in programs.list %}
              <option>{{ program.title }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="mt-5">
            <label for="message" class="block text-sm font-medium text-ink mb-1.5">Message</label>
            <textarea id="message" name="message" rows="4" required class="w-full rounded-lg border border-border bg-paper px-4 py-2.5 text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"></textarea>
          </div>

          <button type="submit" class="btn-primary mt-6">Send Message</button>
        </form>
      </div>

      <div class="lg:w-2/5">
        <div class="bg-surface rounded-2xl p-8 flex flex-col gap-6">
          <div class="flex items-start gap-3">
            <span class="text-brand shrink-0 mt-0.5">{{ icon("map-pin", "w-5 h-5") }}</span>
            <div>
              <p class="font-medium text-ink text-sm">Office</p>
              <p class="text-ink/65 text-sm mt-0.5">{{ site.address.line1 }}<br>{{ site.address.line2 }}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-brand shrink-0 mt-0.5">{{ icon("phone", "w-5 h-5") }}</span>
            <div>
              <p class="font-medium text-ink text-sm">Phone</p>
              <a href="{{ site.phoneHref }}" class="text-ink/65 text-sm mt-0.5 hover:text-brand transition-colors">{{ site.phone }}</a>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-brand shrink-0 mt-0.5">{{ icon("mail", "w-5 h-5") }}</span>
            <div>
              <p class="font-medium text-ink text-sm">Email</p>
              <a href="mailto:{{ site.email }}" class="text-ink/65 text-sm mt-0.5 hover:text-brand transition-colors">{{ site.email }}</a>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-brand shrink-0 mt-0.5">{{ icon("clock", "w-5 h-5") }}</span>
            <div>
              <p class="font-medium text-ink text-sm">Hours</p>
              <p class="text-ink/65 text-sm mt-0.5">{{ site.hours }}</p>
            </div>
          </div>

          <div class="aspect-video rounded-xl bg-paper flex items-center justify-center border border-border">
            <div class="text-center px-4">
              <span class="inline-flex text-brand">{{ icon("map-pin", "w-6 h-6") }}</span>
              <p class="mt-1.5 text-xs text-ink/50">{{ site.address.line1 }}, {{ site.address.line2 }}</p>
            </div>
          </div>

          <div class="flex items-center gap-4 pt-2 border-t border-border">
            {% for s in site.social %}
            <a href="{{ s.url | url }}" class="text-ink hover:text-brand transition-colors text-sm">{{ s.label }}</a>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% set faqKey = "contact" %}
{% include "partials/faq-accordion.njk" %}
